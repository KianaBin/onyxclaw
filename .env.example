# Select the AgentSphere profile. Copy the example before replacing non-secret
# template, Channel and model values for the target environment.
ONYXCLAW_PROVIDER=huaweicloud-agentsphere
ONYXCLAW_PROVIDER_CONFIG=config/providers.agentsphere.local.json
ONYXCLAW_CLOUD_REGION=

# Secrets referenced by the AgentSphere provider profile.
HUAWEICLOUD_AGENTSPHERE_E2B_API_KEY=
HUAWEICLOUD_AGENTSPHERE_MODEL_API_KEY=
HUAWEICLOUD_AGENTSPHERE_CHANNEL_SIGNING_SECRET=

# Deployment-wide optional configuration.
ARTIFACT_STORE_URL=
