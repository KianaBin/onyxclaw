apiVersion: apps/v1
kind: Deployment
metadata:
  name: onyxclaw-app
  namespace: {{NAMESPACE}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: onyxclaw-app
  template:
    metadata:
      labels:
        app: onyxclaw-app
    spec:
      containers:
        - name: app
          image: {{IMAGE}}
          imagePullPolicy: IfNotPresent
          env:
            - name: ONYXCLAW_PROVIDER
              value: huaweicloud-agentsphere
            - name: ONYXCLAW_PROVIDER_CONFIG
              value: /app/runtime-config/providers.agentsphere.json
            - name: ONYXCLAW_CLOUD_REGION
              value: {{REGION}}
            - name: HUAWEICLOUD_AGENTSPHERE_E2B_API_KEY
              valueFrom:
                secretKeyRef:
                  name: onyxclaw-app-secrets
                  key: e2b-api-key
            - name: HUAWEICLOUD_AGENTSPHERE_MODEL_API_KEY
              valueFrom:
                secretKeyRef:
                  name: onyxclaw-app-secrets
                  key: model-api-key
            - name: HUAWEICLOUD_AGENTSPHERE_CHANNEL_SIGNING_SECRET
              valueFrom:
                secretKeyRef:
                  name: onyxclaw-app-secrets
                  key: channel-signing-secret
            - name: ONYXCLAW_OPENCLAW_BASE_CONFIG_JSON
              valueFrom:
                secretKeyRef:
                  name: onyxclaw-app-secrets
                  key: openclaw-base-config-json
          ports:
            - name: http
              containerPort: 3000
            - name: channel
              containerPort: 18890
          readinessProbe:
            httpGet:
              path: /api/status
              port: http
            initialDelaySeconds: 3
            periodSeconds: 10
          volumeMounts:
            - name: provider-config
              mountPath: /app/runtime-config/providers.agentsphere.json
              subPath: providers.agentsphere.json
              readOnly: true
      volumes:
        - name: provider-config
          configMap:
            name: onyxclaw-provider-config
---
apiVersion: v1
kind: Service
metadata:
  name: onyxclaw-app
  namespace: {{NAMESPACE}}
spec:
  selector:
    app: onyxclaw-app
  ports:
    - name: http
      port: 3000
      targetPort: http
    - name: channel
      port: 18890
      targetPort: channel
