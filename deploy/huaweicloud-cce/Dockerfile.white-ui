ARG APP_IMAGE=swr.cn-south-1.myhuaweicloud.com/demo-test/onyxclaw-app:0.3.8-resume-control-retry@sha256:eca92ff2996b476c1109e85fe2b10a87384601434281fcaffdb315787df7c95c
FROM ${APP_IMAGE}

USER root
COPY index.html /app/packages/local-console/public/index.html
COPY styles.css /app/packages/local-console/public/styles.css
COPY app.js /app/packages/local-console/public/app.js
RUN chown node:node \
      /app/packages/local-console/public/index.html \
      /app/packages/local-console/public/styles.css \
      /app/packages/local-console/public/app.js
USER node
