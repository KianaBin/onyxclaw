ARG APP_IMAGE=swr.cn-south-1.myhuaweicloud.com/demo-test/onyxclaw-app:0.3.8-e2b-traffic-token@sha256:042c6416d5654fe42d743594449abdcf4f67733192f5b817aac67bcfe55bbc6d
FROM ${APP_IMAGE}

USER root
COPY packages/cloud-config/src/provider-registry.js /app/packages/cloud-config/src/provider-registry.js
COPY packages/cloud-runtime/src/cloud-app.js /app/packages/cloud-runtime/src/cloud-app.js
COPY packages/cloud-runtime/src/cloud-controller.js /app/packages/cloud-runtime/src/cloud-controller.js
COPY packages/cloud-runtime/src/e2b-bridge.py /app/packages/cloud-runtime/src/e2b-bridge.py
COPY packages/cloud-runtime/src/e2b-compatible-adapter.js /app/packages/cloud-runtime/src/e2b-compatible-adapter.js
COPY packages/cloud-runtime/src/openclaw-bootstrap.js /app/packages/cloud-runtime/src/openclaw-bootstrap.js
COPY packages/cloud-runtime/src/python-e2b-client.js /app/packages/cloud-runtime/src/python-e2b-client.js
COPY packages/local-console/public/app.js /app/packages/local-console/public/app.js
COPY packages/local-console/public/index.html /app/packages/local-console/public/index.html
COPY packages/local-console/public/styles.css /app/packages/local-console/public/styles.css
COPY packages/local-console/public/ui-state.js /app/packages/local-console/public/ui-state.js
COPY packages/local-console/src/server.js /app/packages/local-console/src/server.js
RUN chown -R node:node /app/packages/cloud-config/src \
      /app/packages/cloud-runtime/src \
      /app/packages/local-console/public \
      /app/packages/local-console/src
USER node
