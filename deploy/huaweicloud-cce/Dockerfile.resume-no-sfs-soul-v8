ARG APP_IMAGE=swr.cn-south-1.myhuaweicloud.com/demo-test/onyxclaw-app:0.3.8-resume-start-ui-v7@sha256:c3c0ee14d457f6664806f2e487590163682c63cb7b016527caa7b16d18e9d3fa
FROM ${APP_IMAGE}

USER root
COPY packages/cloud-runtime/src/cloud-controller.js /app/packages/cloud-runtime/src/cloud-controller.js
COPY packages/cloud-runtime/src/openclaw-bootstrap.js /app/packages/cloud-runtime/src/openclaw-bootstrap.js
COPY packages/local-console/public/app.js /app/packages/local-console/public/app.js
COPY packages/local-console/public/index.html /app/packages/local-console/public/index.html
COPY packages/local-console/public/styles.css /app/packages/local-console/public/styles.css
RUN chown node:node \
      /app/packages/cloud-runtime/src/cloud-controller.js \
      /app/packages/cloud-runtime/src/openclaw-bootstrap.js \
      /app/packages/local-console/public/app.js \
      /app/packages/local-console/public/index.html \
      /app/packages/local-console/public/styles.css
USER node
