RUN chown node:node \
      /app/packages/cloud-runtime/src/cloud-controller.js \
      /app/packages/cloud-runtime/src/e2b-bridge.py \
      /app/packages/cloud-runtime/src/python-e2b-client.js \
      /app/packages/local-console/public/app.js
