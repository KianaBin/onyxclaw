ARG APP_IMAGE=swr.cn-south-1.myhuaweicloud.com/demo-test/onyxclaw-app:0.3.8-resume-sfs-soul-v11@sha256:d72d3b7526c1974b9b4b0b0bcc5398cef877913be8872a4350a9dffd84a8a1f7
FROM ${APP_IMAGE}

USER root
COPY packages/cloud-runtime/src/cloud-controller.js /app/packages/cloud-runtime/src/cloud-controller.js
COPY packages/cloud-runtime/src/e2b-bridge.py /app/packages/cloud-runtime/src/e2b-bridge.py
COPY packages/cloud-runtime/src/python-e2b-client.js /app/packages/cloud-runtime/src/python-e2b-client.js
