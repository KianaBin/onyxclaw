ARG APP_IMAGE=swr.cn-south-1.myhuaweicloud.com/demo-test/onyxclaw-app:0.3.8-resume-rebootstrap-v6@sha256:d1ca1cf76ae5da9db85b4bd2e887188ebf34e079fc710dc6960bdeb06df0843f
FROM ${APP_IMAGE}

USER root
COPY packages/cloud-runtime/src/cloud-controller.js /app/packages/cloud-runtime/src/cloud-controller.js
COPY packages/local-console/public/app.js /app/packages/local-console/public/app.js
COPY packages/local-console/public/index.html /app/packages/local-console/public/index.html
