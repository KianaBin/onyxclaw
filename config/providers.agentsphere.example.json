{
  "schemaVersion": 1,
  "defaultProvider": "huaweicloud-agentsphere",
  "providers": {
    "huaweicloud-agentsphere": {
      "displayName": "Huawei Cloud AgentSphere Sandbox",
      "protocol": "e2b-compatible",
      "api": {
        "baseUrl": "https://sandbox-service-internel.cn-southwest-301.beta.myhuaweicloud.com",
        "privateNetworkOnly": true,
        "apiKeyEnv": "HUAWEICLOUD_AGENTSPHERE_E2B_API_KEY",
        "compatibilityVersion": "e2b-v2",
        "requestTimeoutMs": 30000
      },
      "sandbox": {
        "templateId": "replace-with-agentsphere-template-id",
        "timeoutMs": 600000,
        "onTimeout": "kill",
        "secure": true,
        "defaultUser": "node",
        "homeDir": "/home/node",
        "workspaceDir": "/home/node/.openclaw/workspace"
      },
      "openclaw": {
        "binary": "openclaw",
        "gatewayPort": 18789,
        "installMode": "preinstalled",
        "pluginInstallMode": "preinstalled"
      },
      "channel": {
        "publicUrl": "wss://replace-with-channel-domain/connect",
        "privateNetworkOnly": true,
        "connectTimeoutMs": 120000,
        "signingSecretEnv": "HUAWEICLOUD_AGENTSPHERE_CHANNEL_SIGNING_SECRET"
      },
      "model": {
        "provider": "openai-compatible",
        "model": "replace-with-model-id",
        "apiKeyEnv": "HUAWEICLOUD_AGENTSPHERE_MODEL_API_KEY"
      },
      "cleanupPolicy": "kill",
      "capabilities": {
        "pauseResume": false,
        "memoryPersistence": false,
        "publicEgress": false,
        "vpc": true
      }
    }
  }
}
