    { "id": "reply", "from": "model", "to": "gateway", "y": 530, "label": "回复内容", "variant": "return" },
    { "id": "deliver", "from": "gateway", "to": "channel", "y": 610, "label": "交付回复", "variant": "return" },
    { "id": "outbound", "from": "channel", "to": "app", "y": 690, "label": "WebSocket 出站事件（inReplyTo = inboundEventId）", "variant": "emphasis" }
