  "cards": [
    { "dot": "rose", "title": "关联不变量", "items": ["每个出站回复必须携带 inReplyTo", "APP 使用实例 ID 与入站事件 ID 将回复交还给原请求", "模型失败也应交付关联的可操作错误回复"] }
  ]
