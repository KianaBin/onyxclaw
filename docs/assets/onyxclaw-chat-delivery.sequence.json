    { "id": "channel", "type": "backend", "label": "Sandbox 内 Channel" },
    { "id": "gateway", "type": "backend", "label": "OpenClaw Gateway" },
    { "id": "model", "type": "external", "label": "模型服务" }
  ],
  "messages": [
    { "id": "send", "from": "browser", "to": "app", "y": 190, "label": "发送聊天消息", "variant": "emphasis" },
    { "id": "inbound", "from": "app", "to": "channel", "y": 280, "label": "WebSocket 入站事件（eventId, chatId, text）", "variant": "emphasis", "note": "APP 先登记 Reply Correlation Key（instanceId + inboundEventId），不能按下一条回复或 FIFO 匹配。" },
